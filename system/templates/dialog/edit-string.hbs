<div>
	<input
		name="value"
		data-dtype="String"
		style="border: none;"
		type="text"
		value="{{value}}"
		autofocus
	>
	<input
		name="index"
		data-dtype="Number"
		type="hidden"
		value="{{index}}"
	>
	<input
		name="actorUuid"
		data-dtype="String"
		type="hidden"
		value="{{actorUuid}}"
	>
	<input
		name="type"
		data-dtype="String"
		type="hidden"
		value="{{type}}"
	>
</div>
