<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="special_ability"
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.SpecialAbilities"}}
	</span>

	<ol class="item-list">
		{{#if (lookup inventory "special_ability")}}
			{{#each (lookup inventory "special_ability")}}
				<li
					class="item draggable"
					{{#if @root.editModeEnabled}}
						data-action="editItem"
					{{else}}
						data-action="useSpecialAbility"
					{{/if}}
					data-uuid="{{this.uuid}}"
					data-item-id="{{this.id}}"
				>
					<a>
						<b class="item-name">
							{{this.name}}
						</b>
						<em>
							{{{this.enrichedDescription}}}
						</em>
					</a>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
