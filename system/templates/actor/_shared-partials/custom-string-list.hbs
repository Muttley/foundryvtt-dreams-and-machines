{{#if sectionTitle}}
	<span class="label">
		{{#unless @root.editModeDisabled}}
			<a
				data-action="addString"
				data-key="{{key}}"
				data-tooltip="{{titleAdd}}"
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/unless}}
		{{sectionTitle}}
	</span>
{{/if}}
<div
	class="custom-string"
	{{#unless @root.editModeDisabled}}
		data-tooltip="{{tooltip "edit-delete-mouse-controls"}}"
	{{/unless}}
>
	{{#if addRowLabel}}
		<div class="add-string-row">
			<p class="string-header">
				{{#unless @root.editModeDisabled}}
					<a
						data-action="addString"
						data-key="{{key}}"
						data-tooltip="{{titleAdd}}"
					>
						<i class="fa-solid fa-square-plus"></i>
					</a>
					&nbsp;
				{{/unless}}
				{{addRowLabel}}
			</p>
		</div>
	{{/if}}
	{{#if currentValues}}
		{{#each currentValues}}
			<p
				class="string-edit"
				data-action="editString"
				data-index="{{@index}}"
				data-key="{{../key}}"
			>
				{{this}}
			</p>
		{{/each}}
	{{else}}
		<p></p>
	{{/if}}
</div>
