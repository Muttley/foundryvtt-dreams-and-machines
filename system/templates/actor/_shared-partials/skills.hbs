<div class="grid-7-columns">
	{{#each skills}}
		<div>
			<span class="label">
				<a
					data-action="onRoll"
					data-skill="{{this.key}}"
				>
					<i class="fas fa-dice-d20"></i>
					{{label}}
				</a>
			</span>

			<input
				class="lockable"
				data-type="Number"
				name="system.skills.{{this.key}}"
				placeholder="&mdash;"
				type="number"
				value="{{this.value}}"
				{{disabled @root.editModeDisabled}}
			/>
		</div>
	{{/each}}
</div>
