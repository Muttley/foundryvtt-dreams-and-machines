<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="weapon"
				{{disabled @root.editModeDisabled}}
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.Weapons"}}
	</span>

	<ol
		class="item-list"
		{{#unless @root.editModeDisabled}}
			data-tooltip="{{tooltip "edit-delete-mouse-controls"}}"
		{{/unless}}
	>
		{{#if weapons}}
			{{#each weapons}}
				<li
					class="item"
					{{#if @root.editModeEnabled}}
						data-action="editItem"
					{{else}}
						data-action="onRoll"
					{{/if}}
					data-type="main"
					data-uuid="{{this.uuid}}"
				>
					<a>
						<i class="fas fa-dice-d20"></i>
						<b style="text-transform: uppercase">
							{{this.name}} ({{this.type}}):
						</b>
						<em>
							{{#if this.damage}}
								{{#each this.damage}}
									{{ type }} {{ value }}{{#unless @last}},{{/unless}}
								{{/each}}
							{{else}}
								&mdash;
							{{/if}}
						</em>
					</a>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
