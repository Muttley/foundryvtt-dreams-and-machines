<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="weapon"
				{{disabled @root.editModeDisabled}}
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.Weapons"}}
	</span>

	<ol class="item-list">
		{{#if (lookup inventory "weapon")}}
			{{#each (lookup inventory "weapon") as |weapon|}}
				<li
					class="item draggable"
					{{#if @root.editModeEnabled}}
						data-action="editItem"
					{{else}}
						data-action="onRoll"
					{{/if}}
					data-type="main"
					data-uuid="{{weapon.uuid}}"
					data-item-id="{{weapon.id}}"
				>
					<a>
						<i class="fas fa-dice-d20"></i>
						<b class="item-name">
							{{weapon.name}} ({{weapon.system.weaponType}}):
						</b>
						{{#if weapon.system.damage}}
							{{#each weapon.system.damage as |damage|}}
								{{damage.type}} {{damage.value}}{{#unless @last}},{{else}}.{{/unless}}
							{{/each}}
						{{else}}
							&mdash;
						{{/if}}
						{{#if weapon.enabledQualities}}
							<em>
								{{#each weapon.enabledQualities as |quality|}}
									{{quality.name}}{{#unless @last}},{{/unless}}
								{{/each}}
							</em>
						{{else}}
							&mdash;
						{{/if}}
					</a>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
