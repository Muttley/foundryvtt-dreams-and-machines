<div>
	<span class="label">
		{{localize "DNM.Labels.Weapons"}}
	</span>

	<ol class="item-list">
		{{#each weapons}}
			<li
				class="item"
				data-menu="item"
				data-uuid="{{this.uuid}}"
			>
				<a
					data-action="onRoll"
					data-type="main"
					data-uuid="{{this.uuid}}"
				>
					<i class="fas fa-dice-d20"></i>
					<b style="text-transform: uppercase">
						{{this.name}}
						({{this.type}})</b>:
					<i>
						{{#if this.qualities}}
							{{#each this.qualities}}
								<em>{{name}}{{#if hasValue}} {{ value }}{{/if}}{{#unless @last}},{{/unless}}</em>
							{{/each}}
						{{else}}
							&mdash;
						{{/if}}
					</i>
				</a>
			</li>
		{{/each}}
	</ol>
</div>
