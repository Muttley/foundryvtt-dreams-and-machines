<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="npc_action"
				{{disabled @root.editModeDisabled}}
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.Actions"}}
	</span>

	<ol class="item-list">
		{{#if actions}}
			{{#each actions}}
				<li
					class="item"
					data-menu="item"
					data-uuid="{{this.uuid}}"
				>
					<a
						data-action="roll"
						data-uuid="{{uuid}}"
					>
						<b style="text-transform: uppercase">
							{{this.name}}:
						</b>
					</a>
						<em>
							{{{this.enrichedDescription}}}
						</em>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
