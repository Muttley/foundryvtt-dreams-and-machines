<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="special_ability"
				{{disabled @root.editModeDisabled}}
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.SpecialAbilities"}}
	</span>

	<ol class="item-list">
		{{#if specialAbilities}}
			{{#each specialAbilities}}
				<li
					class="item"
					data-menu="item"
					data-uuid="{{this.uuid}}"
				>
					<a
						data-action="useSpecialAbility"
						data-uuid="{{uuid}}"
					>
						<i class="fas fa-dice-d20"></i>
						<b style="text-transform: uppercase">{{this.name}}</b>:
						<em>
							{{{this.system.description}}}
						</em>
					</a>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
