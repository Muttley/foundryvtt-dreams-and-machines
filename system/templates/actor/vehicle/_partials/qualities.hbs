<div>
	<span class="label">
		{{localize "DNM.Labels.Qualities"}}
	</span>

	<div class="grid-2-columns">
		{{#each qualities}}
			<div
				{{#if this.enabled}}
					class="selectable-choice selected"
				{{else}}
					class="selectable-choice"
				{{/if}}
				data-action="toggleQuality"
				data-enabled="{{this.enabled}}"
				data-key="{{this.key}}"
				data-system-property="system.qualities"
				data-tooltip="{{localize (concat "DNM.QualityTooltip.Vehicle." this.key)}}"
			>
				<label>
					{{this.name}}
					{{#if this.enabled}}
						{{#if this.hasValue}}
							{{#if @root.editModeDisabled}}
								({{this.value}})
							{{else}}
								<input
									data-dtype="Number"
									name="system.qualities.{{this.key}}.value"
									type="number"
									value="{{this.value}}"
									{{disabled @root.editModeDisabled}}
								>
							{{/if}}
						{{/if}}
					{{/if}}
				</label>
			</div>
		{{/each}}
	</div>

</div>

