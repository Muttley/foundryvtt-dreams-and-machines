<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="major_npc_action"
				{{disabled @root.editModeDisabled}}
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
			{{localize "DNM.Labels.Actions"}}
		{{else}}
			<a data-action="onRollMajorAction">
				<i class="fas fa-dice-d20"></i>
				{{localize "DNM.Labels.Actions"}}
			</a>
		{{/if}}
	</span>

	<ol
		class="item-list"
		{{#unless @root.editModeDisabled}}
			data-tooltip="{{tooltip "edit-delete-mouse-controls"}}"
		{{/unless}}
	>
		{{#if (lookup inventory "major_npc_action")}}
			{{#each (lookup inventory "major_npc_action")}}
				<li
					class="item draggable"
					{{#if @root.editModeEnabled}}
						data-action="editItem"
					{{else}}
						data-action="useSpecialAbility"
					{{/if}}
					data-item-id="{{this.id}}"
					data-uuid="{{this.uuid}}"
				>
					<i class="fas fa-dice-d20"></i>
					<b class="item-name">
						[{{this.system.roll.min}}-{{this.system.roll.max}}]
						{{this.name}}:
					</b>
					<em>
						{{{this.enrichedDescription}}}
					</em>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
