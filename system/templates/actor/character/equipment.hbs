<div class="equipment">
	<span class="label">
		{{localize "DNM.Labels.Equipment"}}
	</span>

	<ol class="item-list">
		{{#each weapons}}
		<li
			class="item"
			data-menu="item"
			data-uuid="{{uuid}}"
		>
			{{#if (or (eq system.weaponType 'Melee') (eq system.weaponType 'MeleeRanged'))}}
				<a
					data-action="roll"
					data-attribute="might"
					data-skill="fight"
					data-uuid="{{this.uuid}}"
				>
					<i class="fas fa-sword"></i>
				</a>
			{{/if}}

			{{#if (or (eq system.weaponType 'Ranged') (eq system.weaponType 'MeleeRanged'))}}
				<a
					data-action="roll"
					data-attribute="quickness"
					data-skill="fight"
					data-uuid="{{uuid}}"><i class="fas fa-bow-arrow"></i></a>
			{{/if}}

			<a
				class="font-bold"
				data-action="open-sheet"
				data-uuid="{{uuid}}"
			>
				{{name}}
				{{#if (gt system.techLevel 0)}}
					(TL{{ system.techLevel }},
					{{localize (concat "DNM.Labels.Weapon." system.weaponType)}})
				{{else}}
					({{localize (concat "DNM.Labels.Weapon." system.weaponType)}})
				{{/if}}
				{{#if system.hasQualities}}:{{else}}.{{/if}}
			</a>
		</li>
		{{/each}}
	</ol>
</div>
