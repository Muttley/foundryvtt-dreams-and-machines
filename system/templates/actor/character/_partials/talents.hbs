<div>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a
				data-action="addItem"
				data-item-type="talent"
				{{disabled @root.editModeDisabled}}
			>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.Talents"}}
	</span>

	<ol class="item-list">
		{{#if (lookup inventory "talent")}}
			{{#each (lookup inventory "talent")}}
				<li
					class="item draggable"
					data-action="showDescription"
					data-item-id="{{this.id}}"
					data-uuid="{{this.uuid}}"
				>
					<b class="item-name">
						{{this.name}}
					</b>
					<em class="hideable hidden">
						{{{this.enrichedDescription}}}
					</em>
				</li>
			{{/each}}
		{{else}}
			<div class="placeholder">
				{{localize "DNM.Placeholders.None"}}
			</div>
		{{/if}}
	</ol>
</div>
