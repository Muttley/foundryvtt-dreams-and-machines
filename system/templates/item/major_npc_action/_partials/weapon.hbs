	<div class="grid-3-columns">
		<div class="grid-colspan-2 grid-rowspan-3">
			{{> (template "item/major_npc_action/_partials/qualities") }}
		</div>
		<div class="grid-1-columns">
			{{> (template "item/major_npc_action/_partials/name") }}
