<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
	<div class="tab-body">
		{{> (template "item/_shared-partials/attributes") }}
		{{> (template "item/_shared-partials/skills") }}

		<div class="grid-3-columns">
			{{> (template "item/_shared-partials/tech-level") }}
			{{> (template "item/_shared-partials/spirit") }}
			{{> (template "item/_shared-partials/supply-points") }}
		</div>

		{{> (template "item/_shared-partials/narrow-text-field")
			key="goals"
			label=(localize "DNM.Labels.Goals")
		}}

		{{> (template "item/_shared-partials/narrow-text-field")
			key="equipment"
			label=(localize "DNM.Labels.Equipment")
		}}
	</div>
</section>
