<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
	<div class="tab-body">
		{{> (template "item/archetype/_partials/attributes") }}
		{{> (template "item/archetype/_partials/skills") }}

		<div class="grid-3-columns">
			{{> (template "item/_shared-partials/tech-level") }}
			{{> (template "item/_shared-partials/spirit") }}
			{{> (template "item/_shared-partials/supply-points") }}
		</div>

		{{> (template "item/archetype/_partials/goals") }}
		{{> (template "item/archetype/_partials/equipment") }}
	</div>
</section>
