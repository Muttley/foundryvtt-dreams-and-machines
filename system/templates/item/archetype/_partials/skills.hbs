<div class="grid-1-columns">

	<span class="label">
		{{localize "DNM.Labels.Skills"}}
	</span>

	<div class="grid-4-columns">

		{{#each skills}}
			<a
				{{#if this.selected}}
					class="selectable-choice selected"
				{{else}}
					class="selectable-choice"
				{{/if}}
				data-action="toggleSkillChoice"
				data-skill-id="{{this.id}}"
				{{disabled @root.editModeDisabled}}
			>
				{{this.name}}
			</a>
		{{/each}}

	</div>

</div>
