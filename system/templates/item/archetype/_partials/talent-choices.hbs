<span class="label">
	{{localize "DNM.Labels.TalentChoices"}}
</span>
	<div class="grid-3-columns">
		<div class="grid-colspan-2">
			{{> (template "item/_shared-partials/choice-selector")
				config=talentChoicesConfig
				editable=editable
			}}
		</div>
		<label class="sublabel" style="display: block;">
			<span>
				{{localize "DNM.Labels.Choices"}}
			</span>
			<input
				data-type="Number"
				name="system.talentChoices.maxChoices"
				type="number"
				value="{{system.talentChoices.maxChoices}}"
				{{disabled @root.editModeDisabled}}
			/>
		</label>
	</div>
