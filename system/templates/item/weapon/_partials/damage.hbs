<label>
	<span class="label">
		{{#if @root.editModeEnabled}}
			<a data-action="addDamageType" {{disabled @root.editModeDisabled}}>
				<i class="fa-solid fa-plus"></i>
			</a>
			&nbsp;
		{{/if}}
		{{localize "DNM.Labels.Damage"}}
	</span>
	<div class="damage-type-grid {{#if @root.editModeDisabled}}disabled{{/if}}">
		{{#each system.damage}}
			<input
				class="lockable"
				type="text"
				name="system.damage.{{@index}}.type"
				value="{{this.type}}"
				placeholder="{{localize "DNM.Labels.DamageType"}}"
				{{disabled @root.editModeDisabled}}
			/>
			<input
				class="lockable"
				type="number"
				name="system.damage.{{@index}}.value"
				value="{{this.value}}"
				{{disabled @root.editModeDisabled}}
			/>
			{{#if @root.editModeEnabled}}
				<a
					data-action="deleteDamageType"
					data-tooltip="{{localize "DNM.Labels.Delete"}}"
					{{disabled @root.editModeDisabled}}
				>
					<i class="fas fa-trash" data-index="{{@index}}"></i>
				</a>
			{{/if}}
		{{/each}}
	</div>
</label>
