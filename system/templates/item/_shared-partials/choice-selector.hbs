<div class="multi-select grid-1-columns">

	<input
		{{!--
			list name needs to be unique and match the one used in the
			datalist below.  Using the item id plus the system data key field
			here should be unique enough
		--}}
		data-action="selectChoice"
		data-choices-key="{{config.choicesKey}}"
		data-is-item="{{config.isItem}}"
		id="{{@root.rootId}}_{{config.choicesKey}}_input"
		list="{{@root.rootId}}_{{config.choicesKey}}_list"
		placeholder="{{localize "DNM.Labels.StartTyping"}}"
		type="text"
		value=""
		{{disabled @root.editModeDisabled}}
	/>
	<datalist id="{{@root.rootId}}_{{config.choicesKey}}_list">
		{{#each config.availableItems}}
			<option
				data-uuid="{{this.uuid}}"
				value="{{this.name}}"
			></option>
		{{/each}}
	</datalist>

	{{#if config.selectedItems}}
		<div class="items flexrow">
			{{#each config.selectedItems}}
				<div class="selected-item flexrow">
					<a
						{{#if ../config.isItem}}
							class="content-link uuid-link"
							data-link
							draggable="true"
						{{else}}
							class="fake-uuid-link"
						{{/if}}
						data-type="Item"
						data-uuid="{{this.uuid}}"
					>
						{{#if ../editable}}
							<i
								class="delete-choice fas fa-delete-right"
								data-tooltip="{{localize 'DNM.Tooltips.Item.RemoveSelectedItem'}}"
								data-action="deleteChoice"
								data-choices-key="{{../config.choicesKey}}"
								data-uuid="{{this.uuid}}"
							></i>
						{{/if}}
						{{this.name}}
					</a>
				</div>
			{{/each}}
		</div>
	{{/if}}

</div>
