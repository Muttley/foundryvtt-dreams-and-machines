<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
	<div class="tab-body">
		<div class="grid-4-columns">
			<div class="grid-colspan-2">
				{{> (template "item/_shared-partials/category") }}
			</div>
			{{> (template "item/_shared-partials/tech-level") }}
			{{> (template "item/_shared-partials/quantity") }}
			<div class="grid-colspan-2 grid-rowspan-3">
				{{> (template "item/armor/_partials/qualities") }}
			</div>
			{{> (template "item/_shared-partials/rarity") }}
			{{> (template "item/_shared-partials/coin") }}
			{{> (template "item/armor/_partials/protection") }}
		</div>
	</div>
</section>
