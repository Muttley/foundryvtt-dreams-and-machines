<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="attributes">
	<div class="tab-body">
		{{> (template "item/origin/_partials/attributes") }}
		{{> (template "item/origin/_partials/attribute-choices") }}
		{{> (template "item/origin/_partials/skills") }}
		{{> (template "item/origin/_partials/skill-choices") }}

		<div class="grid-3-columns">
			{{> (template "item/_shared-partials/tech-level") }}
