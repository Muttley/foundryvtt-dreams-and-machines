<div class="dnm chat-message">
	{{#if item}}
		<span class="item-name">
			{{!-- Show the weapon name, rather than Action name, for Major NPC actions. --}}
			{{#if (and item.system.weapon item.system.weapon.name)}}
				{{item.system.weapon.name}}
			{{else}}
				{{item.name}}
			{{/if}}
		</span>
		{{#if item.system.damage}}
			<span class="item-damage">
				{{#each item.system.damage}}
					{{this.type}} {{this.value}}{{#unless @last}}<br>{{/unless}}
				{{/each}}
			</span>
		{{/if}}
		{{#if item.system.weapon.damage}}
			<span class="item-damage">
				{{#each item.system.weapon.damage}}
					{{this.type}} {{this.value}}{{#unless @last}}<br>{{/unless}}
				{{/each}}
			</span>
		{{/if}}
		{{#if (and item item.system.isWeapon)}}
			<span class="result-item" style="grid-column: span 2">
				<span class="result-item-header">
					{{localize "DNM.Labels.Qualities" }}
				</span>
				<span class="qualities">
					{{#if item.enabledQualities}}
						<em>
							{{#each item.enabledQualities as |quality|}}
								<span
									data-tooltip="{{localize (concat "DNM.QualityTooltip.Weapon." quality.key)}}"
								>{{quality.name}}{{#if @last}}.{{else}},{{/if}}</span>
							{{/each}}
						</em>
					{{else}}
						&mdash;
					{{/if}}
				</span>
			</span>
		{{/if}}
	{{/if}}

	<span class="chat-description">
		{{#if npcRoll}}
			{{rollTitle}}
		{{else}}
			{{#if skill}}
				{{attribute}} + {{skill}}
			{{else}}
				{{attribute}}
			{{/if}}
		{{/if}}
	</span>

	<span class="result-grid">
		<span class="result-item">
			<span class="result-item-header">
				{{localize "DNM.Labels.TargetNumber"}}
			</span>
			{{targetNumber}}
			({{skillValue}})
		</span>

		<span class="result-item">
			<span class="result-item-header">
				{{localize "DNM.Labels.DicePrompt.Complication"}}
			</span>
			{{#if (lt complicationRange 20)}}
				{{complicationRange}}&dash;20
			{{else}}
				{{complicationRange}}
			{{/if}}
		</span>

		<span class="result-item">
			<span class="result-item-header">
				{{localize "DNM.Labels.Successes"}}
			</span>
			<span>{{ successes }}</span>
		</span>

		<span class="result-item">
			<span
				{{#ifCond complications "===" 0}}
					class="result-item-header"
				{{else}}
					class="result-item-header complication"
				{{/ifCond}}
			>
				{{localize "DNM.Labels.Complications"}}
			</span>
			{{complications}}
		</span>
	</span>

	<div class="dice-list">
		{{#each results}}
			<div style="position: relative;" data-tooltip="{{this.tooltip}}">
				<i class="fat fa-dice-d20 dice-icon"></i>
				<div
					{{#if isFail}}
						class="dice-number failure"
					{{/if}}
					{{#if isComplication}}
						class="dice-number complication"
					{{/if}}
					{{#if isSuccess}}
						{{#if isCritical}}
							class="dice-number critical"
						{{else}}
							class="dice-number"
						{{/if}}
					{{/if}}
				>
					{{face}}
				</div>
			</div>
		{{/each}}
	</div>
</div>
