<header class="sheet-header">
	<img
		alt="{{document.name}}"
		class="document-image"
		data-action="editImage"
		data-edit="img"
		src="{{document.img}}"
	/>
	<input
		class="name-input"
		name="name"
		type="text"
		value="{{document.name}}"
		{{disabled editModeDisabled}}
	/>
	<div>
		{{#if isItem}}
			<a
				class="sheet-header-control"
				data-action="sendToChat"
				data-uuid="{{document.uuid}}"
			>
				<i
					class="fa-solid fa-message"
					data-tooltip="DNM.Labels.SendToChat"
				></i>
			</a>
		{{/if}}
		<a class="sheet-header-control" data-action="toggleEditMode">
			{{#if editModeEnabled}}
				<i
					class="fa-solid fa-lock-open"
					data-tooltip="DNM.Tooltips.Sheet.LockSheet"
				></i>
			{{else}}
				<i
					class="fa-solid fa-lock"
					data-tooltip="DNM.Tooltips.Sheet.UnlockSheet"
				></i>
			{{/if}}
		</a>
	</div>
</header>
