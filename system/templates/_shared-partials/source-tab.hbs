<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="source">
	<div class="tab-body">
		<select name="system.source" {{disabled editModeDisabled}}>
			<option value="">&mdash;</option>
			{{selectOptions allSources
				labelAttr="name"
				selected=@root.system.source
				valueAttr="uuid"
			}}
		</select>
	</div>
</section>
